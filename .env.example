# Проект обязан полностью работать без единого внешнего API-ключа
# (agents.md §2). Отсутствие любого значения ниже деградирует функцию,
# а не ломает приложение.

# --- Supabase (фаза 1 «Данные и доступ») ---
# Локально: `supabase start` в Docker. В облаке — из настроек проекта Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Персональные данные (agents.md §11.1, ADR-0005) ---
# По умолчанию не задано — packages/pd читает users/requests через ту же
# Supabase-сессию, что и остальной код. PD_BACKEND=postgres переключает
# на прямое подключение к отдельному Postgres (например, казахстанскому
# ДЦ) — см. docs/runbook-migration.md, раздел 4.
PD_BACKEND=
PD_DATABASE_URL=

# --- Почта (опционально, деградирует в запись в таблицу outbox) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=

# --- Подписанные ссылки без входа (agents.md §9, §10) ---
# HMAC-секрет для apps/web/app/lib/signed-link.ts — ссылки для жюри на
# /metrics и защищённого ответа поставщика на RFQ. Без
# значения используется НЕбезопасная dev-заглушка (agents.md §2 — проект
# обязан запускаться без единого внешнего ключа), в проде обязателен
# случайный секрет (например `openssl rand -base64 32`).
LINK_SIGNING_SECRET=

# --- Фича-флаги ---
# По умолчанию выключено. Включение требует обязательного maskPII() —
# см. agents.md §11.2. Не включать без реализации маскирования.
FEATURE_LLM_ASSIST=false
