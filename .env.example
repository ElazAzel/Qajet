# Проект обязан полностью работать без единого внешнего API-ключа
# (agents.md §2). Отсутствие любого значения ниже деградирует функцию,
# а не ломает приложение.

# --- Supabase (фаза 1 «Данные и доступ») ---
# Локально: `supabase start` в Docker. В облаке — из настроек проекта Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Почта (опционально, деградирует в запись в таблицу outbox) ---
RESEND_API_KEY=

# --- Фича-флаги ---
# По умолчанию выключено. Включение требует обязательного maskPII() —
# см. agents.md §11.2. Не включать без реализации маскирования.
FEATURE_LLM_ASSIST=false
