{
  "name": "@qajet/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:inventory": "tsx src/scripts/security-definer-inventory.ts",
    "db:reset": "tsx src/scripts/reset.ts",
    "db:provision-clients": "tsx src/scripts/provision-clients.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed/index.ts",
    "db:dump-sql": "tsx src/scripts/dump-seed-sql.ts",
    "db:demo-order": "tsx src/scripts/dump-demo-order-sql.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:rls": "node ../../tools/ci/require-database-url.mjs && vitest run src/__tests__",
    "clean": "rm -rf .turbo"
  },
  "dependencies": {
    "@qajet/engine": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.115.0",
    "@types/node": "22.20.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
