# Переменные для `docker-compose.yml` (фаза 8, переносимость). Скопировать
# в `.env` рядом с docker-compose.yml — docker compose читает `.env` из
# той же директории автоматически, без --env-file.

# --- Postgres (хранилище данных приложения) ---
# Если поднимаете docker-compose.supabase.yml (self-hosted Auth/REST,
# см. ниже) — ОБЯЗАТЕЛЬНО POSTGRES_USER=postgres и POSTGRES_DB=postgres,
# не qajet: образ supabase/postgres и docker/supabase-init/*.sql жёстко
# рассчитаны на суперпользователя и базу данных с этими именами (та же
# конвенция, что у официального self-hosted Supabase). Без этого оверлея
# значения qajet/qajet ниже — обычный дефолт, ничего не подразумевают.
POSTGRES_DB=qajet
POSTGRES_USER=qajet
POSTGRES_PASSWORD=
# Порт нужен переменной только при self-hosted Supabase (auth/rest должны
# знать, куда стучаться) — сам сервис postgres слушает 5432 всегда.
POSTGRES_PORT=5432

# --- MinIO (S3-совместимое хранилище — подключено, ещё не используется
#     ни одним путём кода, см. комментарий в docker-compose.yml) ---
MINIO_ROOT_USER=qajet
MINIO_ROOT_PASSWORD=

# --- Auth/PostgREST — Supabase Cloud или self-hosted (см. блок ниже и
#     docker-compose.supabase.yml). Приложение говорит с этим слоем по
#     HTTP, не с `postgres` выше напрямую (пока схема и данные физически
#     не перенесены — см. docs/runbook-migration.md). ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Почта (опционально, деградирует в запись в таблицу outbox) ---
RESEND_API_KEY=

# --- Self-hosted Supabase Auth/REST (docker-compose.supabase.yml,
#     docs/decisions/0008-self-hosted-supabase-minimal-services.md).
#     Нужны ТОЛЬКО если реально поднимаете этот оверлей — иначе оставить
#     пустыми, Supabase Cloud (переменные выше) их не требует. ---

# Минимум 32 случайных символа: openssl rand -base64 32
JWT_SECRET=
# Время жизни токена в секундах.
JWT_EXPIRY=3600

# HS256 JWT с claim role: anon / service_role, подписанные тем же
# JWT_SECRET — НЕ произвольные строки. Сгенерировать:
#   JWT_SECRET=<тот же секрет, что выше> node docker/supabase-init/generate-keys.mjs
ANON_KEY=
SERVICE_ROLE_KEY=

# NEXT_PUBLIC_SUPABASE_URL выше должен указывать на шлюз (по умолчанию
# http://localhost:8000, тот же порт, что SUPABASE_GATEWAY_PORT ниже).
API_EXTERNAL_URL=http://localhost:8000/auth/v1
# Адрес приложения — GoTrue сверяет redirect-ссылки в письмах с ним.
SITE_URL=http://localhost:3000

# Порт, на котором шлюз слушает снаружи контейнера (см. также
# SUPABASE_PUBLIC_URL/API_EXTERNAL_URL выше — должны указывать на него же).
SUPABASE_GATEWAY_PORT=8000

# Схемы, которые PostgREST отдаёт через /rest/v1 — этому проекту нужна
# только public (RLS-политики только там, см. packages/db/migrations).
PGRST_DB_SCHEMAS=public

# --- GoTrue: почта (опционально — без SMTP подтверждение регистрации и
#     сброс пароля по email не уйдут, деградирует так же, как
#     RESEND_API_KEY выше для Cloud-варианта) ---
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=QAJET

# Регистрация новых пользователей через self-hosted стек — по умолчанию
# включена (как и на Supabase Cloud). Поставить true, чтобы закрыть.
DISABLE_SIGNUP=false
# Регистрация по email — тоже включена по умолчанию.
ENABLE_EMAIL_SIGNUP=true
# Подтверждение email обязательно по умолчанию (нужен рабочий SMTP выше,
# иначе пользователь не сможет подтвердить регистрацию). true — только
# для локальной отладки без почты, не для реального деплоя.
ENABLE_EMAIL_AUTOCONFIRM=false
