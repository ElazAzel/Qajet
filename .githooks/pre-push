#!/bin/sh
# Проверки перед отправкой в GitHub — бесплатная замена автоматического CI.
#
# Почему не GitHub Actions. На приватном репозитории бесплатно 2 000 минут в
# месяц, каждая задача округляется вверх до целой минуты, а полный набор
# проверок — это восемь задач. Сверх лимита GitHub выставляет счёт, а без
# оплаты не запускает вовсе. Здесь те же проверки идут на вашем компьютере и не
# стоят ничего.
#
# Что входит: линт, проверка типов, модульные тесты — около двух минут.
# Что НЕ входит: тесты с настоящей базой и сквозные сценарии. Они долгие (около
# 13 минут) и требуют запущенного Docker, поэтому запускаются перед слиянием:
#
#     pnpm ci:local
#
# Пропустить хук разово, если отправляете только документацию:
#
#     git push --no-verify

set -e

cd "$(git rev-parse --show-toplevel)"

# Хук никогда не трогает базу данных. DATABASE_URL в окружении может указывать
# куда угодно — в том числе на production, — а тесты с базой пишут в неё данные.
# Без переменной эти тесты пропускаются, и это здесь и нужно.
unset DATABASE_URL

echo ""
echo "── pre-push: линт"
pnpm lint

echo ""
echo "── pre-push: типы"
pnpm typecheck

echo ""
echo "── pre-push: модульные тесты"
pnpm test

echo ""
echo "── pre-push: всё зелёное. Тесты с базой и e2e — pnpm ci:local перед слиянием."
