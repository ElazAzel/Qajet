# Строгие зависимости: пакет обязан объявить то, что импортирует.
# Иначе в монорепо начинают работать случайные транзитивные зависимости.
strict-peer-dependencies=false
auto-install-peers=true

# Сборочные скрипты разрешаем поимённо, а не все подряд.
# Список ведётся в pnpm-workspace.yaml → onlyBuiltDependencies.
