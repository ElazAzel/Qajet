{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QAJET",
  "version": "0.0.0",
  "identifier": "kz.qajet.desktop",
  "build": {
    "devUrl": "https://qajet-seven.vercel.app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QAJET",
        "url": "https://qajet-seven.vercel.app",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "QAJET — оболочка консьержа"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["qajet"]
      }
    }
  }
}
