{
  "name": "qajet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "node tools/dev/install-hooks.mjs",
    "dev": "pnpm --filter @qajet/web dev",
    "dev:bootstrap": "node tools/dev/bootstrap.mjs",
    "build": "pnpm --filter @qajet/web build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "node --test tools/ci/quote-revision-guard.test.mjs tools/ci/job-workflow.test.mjs tools/ci/release-cli.test.mjs tools/ci/release-contract.test.mjs tools/ci/summarize-gates.test.mjs tools/ops/backup-database.test.mjs && turbo run test",
    "test:watch": "turbo run test:watch",
    "e2e": "pnpm --filter @qajet/web build && pnpm --filter @qajet/web e2e",
    "db:generate": "pnpm --filter @qajet/db db:generate",
    "db:migrate": "pnpm --filter @qajet/db db:migrate",
    "db:reset": "pnpm --filter @qajet/db db:reset",
    "db:seed": "pnpm --filter @qajet/db db:seed",
    "release:check": "node tools/ci/check-release-readiness.mjs",
    "ci:local": "node tools/ci/run-local.mjs",
    "rag:sync": "tsx tools/rag/src/cli.ts sync",
    "rag:search": "tsx tools/rag/src/cli.ts search",
    "rag:check": "tsx tools/rag/src/cli.ts check",
    "rag:log": "tsx tools/rag/src/cli.ts log",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:all": "turbo run dev",
    "build:all": "turbo run build",
    "e2e:all": "turbo run e2e",
    "dev:local-env": "node tools/dev/local-supabase-env.mjs",
    "release:check:strict": "node tools/ci/check-release-readiness.mjs --strict"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "turbo": "2.10.12",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
